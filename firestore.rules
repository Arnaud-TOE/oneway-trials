rules_version = '2';

// Firestore holds a single thing: a shared cache of trial eligibility rules compiled
// from PUBLIC ClinicalTrials.gov text. No patient data is ever written here, and
// these rules make it structurally impossible to store anything else.
service cloud.firestore {
  match /databases/{database}/documents {

    match /trialRules/{key} {
      // Signed-in (anonymous) app users may read one entry by its exact key.
      allow get: if request.auth != null;

      // Entries are write-once. The key ties the entry to a trial id, a hash of
      // the exact public source text, and a compiler version. Clients re-verify
      // every cached criterion against the public source before using it.
      // Every identifying field must equal its part of the key (compared as plain
      // strings, never built into a pattern), so an entry cannot claim another trial,
      // another source text or another compiler version than its key says.
      allow create: if request.auth != null
        && key.matches('^NCT[0-9]{8}_[0-9a-f]{16}_v[0-9]{1,3}$')
        && request.resource.data.keys().hasOnly(
             ['nctId', 'criteriaHash', 'compilerVersion', 'model', 'compiledAt', 'criteria'])
        && request.resource.data.nctId == key.split('_')[0]
        && request.resource.data.criteriaHash == key.split('_')[1]
        && request.resource.data.compilerVersion is int
        && key.split('_')[2] == 'v' + string(request.resource.data.compilerVersion)
        && request.resource.data.model is string
        && request.resource.data.model.size() <= 64
        && request.resource.data.criteria is list
        && request.resource.data.criteria.size() > 0
        && request.resource.data.criteria.size() <= 30
        && request.resource.data.compiledAt == request.time;

      allow list, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
