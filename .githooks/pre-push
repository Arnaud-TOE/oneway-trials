#!/bin/sh
# Nothing leaves this machine unless the checks CI runs pass here first,
# and unless no App Check debug token or local secret is about to be pushed.
# `npm install` turns this hook on (see "prepare" in package.json).
set -e

echo "pre-push: checking that no secret is tracked"
if git ls-files | grep -E '(^|/)\.env(\.[^/]*)?$' | grep -v '\.env\.example$' >/dev/null; then
  echo "pre-push: an .env file is tracked by git. Remove it from the index first." >&2
  exit 1
fi

echo "pre-push: running types and tests"
npm run --silent typecheck
npm test --silent
