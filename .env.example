# Copy to .env.local and fill in with your own Firebase web app configuration.
# Firebase console > Project settings > Your apps > Web app > SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (required by Firebase AI Logic).
# Local development: set VITE_APPCHECK_DEBUG=true and either leave the token empty
# (the SDK prints one in the browser console) or set your own UUID, then register it in
# Firebase console > App Check > Apps > your app > Manage debug tokens.
# Never commit a debug token.
VITE_APPCHECK_DEBUG=true
VITE_APPCHECK_DEBUG_TOKEN=
# Production: reCAPTCHA Enterprise site key registered in App Check.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
